{
  "info": {
    "name": "AutoGiro API",
    "description": "Plataforma de gestão para redes de oficinas mecânicas.\n\nFluxo: obtenha o token em 'Autenticação > Login por CPF' (a variável {{token}} é preenchida automaticamente) e use as demais requisições.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8000",
      "description": "URL do Kong Gateway"
    },
    {
      "key": "auth_endpoint",
      "value": "https://xxxx.lambda-url.us-east-1.on.aws/",
      "description": "Function URL da Lambda de autenticação"
    },
    {
      "key": "token",
      "value": "",
      "description": "Preenchido pelo login"
    },
    {
      "key": "cpf",
      "value": "52998224725"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login por CPF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda o token para as demais requisições da coleção.",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().access_token);",
                  "    pm.test('Token recebido', () => pm.expect(pm.response.json().access_token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpf}}\"\n}"
            },
            "url": {
              "raw": "{{auth_endpoint}}",
              "host": [
                "{{auth_endpoint}}"
              ]
            },
            "description": "Valida o CPF, consulta o cliente no banco e devolve o JWT."
          }
        }
      ]
    },
