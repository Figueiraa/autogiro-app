# ─── Banco de dados ───────────────────────────────────────────────────────────
# Local sem Docker (SQLite, padrão):
DATABASE_URL=sqlite+aiosqlite:///./autogiro.db
# Docker Compose (PostgreSQL local):
# DATABASE_URL=postgresql+asyncpg://autogiro:autogiro@db:5432/autogiro
# Neon (produção) — obtida no painel do Neon, use o driver asyncpg:
# DATABASE_URL=postgresql+asyncpg://user:senha@ep-xxx.neon.tech/autogiro?ssl=require

# ─── Segurança / JWT ──────────────────────────────────────────────────────────
# IMPORTANTE: o mesmo valor precisa estar configurado no repositório autogiro-auth.
# A Lambda assina o token e esta API valida a assinatura com este segredo.
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Observabilidade / HTTP ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# Origens permitidas para CORS (separadas por vírgula). Use origens explícitas em produção.
CORS_ORIGINS=*
# As métricas Prometheus ficam em GET /metrics (sem configuração adicional).

# ─── New Relic (APM) ──────────────────────────────────────────────────────────
# NEW_RELIC_LICENSE_KEY=sua-license-key
# NEW_RELIC_APP_NAME=autogiro-api
# NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# ─── Notificações de mudança de status da OS ──────────────────────────────────
# Canal de envio:
#   auto  (padrão) → e-mail se SMTP_HOST estiver definido, senão log estruturado
#   log            → sempre log estruturado (bom para desenvolvimento e demonstração)
#   email          → sempre e-mail via SMTP (exige SMTP_HOST)
NOTIFICATION_CHANNEL=auto

# Servidor SMTP — necessário apenas quando o canal for e-mail.
# Teste local sem servidor real: `docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog`
# e use SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_USE_TLS=false.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASSWORD=secret
# SMTP_FROM=no-reply@autogiro.com.br
# SMTP_USE_TLS=true
# SMTP_TIMEOUT=10
